<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Edit | Blogify</title>
    <link rel="stylesheet" href="/public/style/style.css" />
  </head>
  <body>
    <%- include("partials/navbar.ejs") %>

    <main class="page-shell">
      <section class="form-card">
        <p class="eyebrow">Update</p>
        <h2>Edit blog</h2>

        <form
          action="/blogs/<%= blog.id %>?_method=PATCH"
          method="post"
          class="form-panel"
        >
          <div class="field">
            <label for="author">Author</label>
            <input
              id="author"
              type="text"
              name="author"
              value="<%= blog.author %>"
              aria-label="Author"
            />
          </div>

          <div class="field">
            <label for="title">Title</label>
            <input
              id="title"
              type="text"
              name="title"
              value="<%= blog.title %>"
              aria-label="Blog title"
            />
          </div>

          <div class="field">
            <label for="content">Blog content</label>
            <textarea id="content" name="content" aria-label="Blog content">
<%= blog.content %></textarea
            >
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Save changes</button>
            <a href="/blogs/<%= blog.id %>" class="btn btn-secondary">Cancel</a>
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
