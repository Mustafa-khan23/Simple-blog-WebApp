<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update | Blogify</title>
    <link rel="stylesheet" href="/public/style/style.css" />
  </head>
  <body>
    <%- include("partials/navbar.ejs") %>

    <main class="page-shell">
      <section class="form-card">
        <p class="eyebrow">Full update</p>
        <h2>Replace the article</h2>

        <form
          action="/blogs/<%= index.id %>?_method=PUT"
          method="post"
          class="form-panel"
        >
          <div class="field">
            <label for="author">Author</label>
            <input
              id="author"
              type="text"
              name="author"
              value="<%= index ? index.author : '' %>"
              aria-label="Author"
            />
          </div>

          <div class="field">
            <label for="title">Title</label>
            <input
              id="title"
              type="text"
              name="title"
              value="<%= index ? index.title : '' %>"
              aria-label="Blog title"
            />
          </div>

          <div class="field">
            <label for="content">Content</label>
            <textarea id="content" name="content" aria-label="Blog content">
<%= index ? index.content : '' %></textarea
            >
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">
              Update article
            </button>
            <a href="/blogs/<%= index.id %>" class="btn btn-secondary"
              >Back to post</a
            >
          </div>
        </form>
      </section>
    </main>
  </body>
</html>
